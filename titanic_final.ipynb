   "source": [
    "'''\n",
    "Titanic Survival Prediction - My First Kaggle Project\n",
    "\n",
    "Learning objectives:\n",
    "- Practice EDA and feature engineering\n",
    "- Compare different ML models (Logistic Regression, Decision Tree, Gradient Boosting)\n",
    "- Hyperparameter tuning with GridSearch/RandomizedSearch\n",
    "- Build a complete ML pipeline\n",
    "\n",
    "Note: This is my first machine learning project, don't judge strictly. \n",
    "I know it can be better, but I’ll take this into account for future projects\n",
    "\n",
    "'''\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.tree import plot_tree, DecisionTreeClassifier\n",
    "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\n",
    "from sklearn.model_selection import cross_val_score, GridSearchCV, RandomizedSearchCV, train_test_split, learning_curve\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import (accuracy_score, classification_report, roc_auc_score, roc_curve, RocCurveDisplay,\n",
    "                             precision_recall_curve, average_precision_score, confusion_matrix, ConfusionMatrixDisplay, PrecisionRecallDisplay)\n",
    "from scipy.stats import randint, uniform\n",
    "from sklearn.ensemble import VotingClassifier\n",
    "# Import all necessary libraries\n",
    "\n",
    "# Data loading and inspection \n",
    "train = pd.read_csv('/kaggle/input/competitions/titanic/train.csv', index_col=0)\n",
    "test = pd.read_csv('/kaggle/input/competitions/titanic/test.csv', index_col=0)\n",
    "\n",
    "train.shape, test.shape # general data inspection\n",
    "train.head()\n",
    "test.head()\n",
    "train.info()\n",
    "test.info()\n",
    "\n",
    "# Exploratory data analysis (plots only)\n",
    "sns.countplot(data=train, x='Survived')\n",
    "plt.title('Survived count')\n",
    "plt.show()\n",
    "\n",
    "sns.histplot(data=train, x='Age')\n",
    "plt.title('Age distribution')\n",
    "plt.show()\n",
    "\n",
    "sns.boxplot(data=train, x='Survived', y='Age')\n",
    "plt.title('Age vs survival')\n",
    "plt.show()\n",
    "\n",
    "sns.histplot(data=train, x='Survived', hue='Pclass')\n",
    "plt.xticks([0, 1])\n",
    "plt.title('Survival by Pclass')\n",
    "plt.show()\n",
    "\n",
    "sns.histplot(data=train, x='Survived', hue='Sex')\n",
    "plt.xticks([0, 1])\n",
    "plt.title('Survival by sex')\n",
    "plt.show()\n",
    "\n",
    "g = sns.catplot(data=train, x='Survived', row='Pclass', col='Sex', kind='count', height=3, aspect=1, margin_titles=True)\n",
    "g.fig.suptitle('Survival dependency on ticket class and gender', y=1.03)\n",
    "plt.show()\n",
    "\n",
    "g_ = sns.catplot(data=train, x='Survived', row='SibSp', col='Pclass', kind='count', height=3, aspect=1, margin_titles=True)\n",
    "g_.fig.suptitle('Survival dependency on number of passenger relatives', y=1.03)\n",
    "plt.show()\n",
    "\n",
    "g1 = sns.catplot(data=train, x='Survived', col='Pclass', row='Parch', kind='count', height=3, aspect=1, margin_titles=True)\n",
    "g1.fig.suptitle('Survival dependency on number of passenger children/parents', y=1.03)\n",
    "plt.show()\n",
    "\n",
    "# Data cleaning and preprocessing (logic only)\n",
    "median_train = train['Age'].median()\n",
    "train['Age'] = train['Age'].fillna(median_train)\n",
    "\n",
    "median_test = test['Age'].median()\n",
    "test['Age'] = test['Age'].fillna(median_test)\n",
    "\n",
    "train['FamilySize'] = train['SibSp'] + train['Parch'] + 1\n",
    "train['IsAlone'] = np.where(train['FamilySize'] == 1, 1, 0)\n",
    "train.drop(['SibSp', 'Parch', 'Ticket', 'Fare', 'Cabin', 'Embarked', 'Name'], axis=1, inplace=True)\n",
    "train = pd.get_dummies(train, columns=['Sex'], drop_first=True)\n",
    "\n",
    "x = train.drop(['Survived'], axis=1)\n",
    "y = train['Survived']\n",
    "\n",
    "x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.3, random_state=42, stratify=y)\n",
    "\n",
    "clf_linear = StandardScaler()\n",
    "x_train_clf = clf_linear.fit_transform(x_train)\n",
    "x_test_clf = clf_linear.transform(x_test)\n",
    "\n",
    "# Logistic regression\n",
    "model_logreg = LogisticRegression(random_state=42, max_iter=1000)\n",
    "model_logreg.fit(x_train_clf, y_train)\n",
    "y_pr_classes = model_logreg.predict(x_test_clf)\n",
    "y_pr_proba = model_logreg.predict_proba(x_test_clf)[:, 1]\n",
    "accuracy_lr = accuracy_score(y_test, y_pr_classes)\n",
    "roc_auc_lr = roc_auc_score(y_test, y_pr_proba) \n",
    "\n",
    "param_grid_lr = {'C': [0.01, 0.1, 1, 10, 100], 'l1_ratio': [0, 1], 'solver': ['liblinear', 'saga'], 'class_weight': [None, 'balanced']}\n",
    "grid_search_lr = GridSearchCV(estimator=LogisticRegression(max_iter=1000, random_state=42), param_grid=param_grid_lr, cv=5, scoring='accuracy', n_jobs=-1, verbose=0)\n",
    "grid_search_lr.fit(x_train_clf, y_train)\n",
    "best_model_logreg = grid_search_lr.best_estimator_\n",
    "y_pred_classes = best_model_logreg.predict(x_test_clf)\n",
    "y_pred_proba = best_model_logreg.predict_proba(x_test_clf)[:, 1]\n",
    "accuracy_bestlr = accuracy_score(y_test, y_pred_classes)\n",
    "roc_auc_bestlr = roc_auc_score(y_test, y_pred_proba)\n",
    "\n",
    "scores = cross_val_score(model_logreg, x_train_clf, y_train, cv=5, scoring='accuracy')\n",
    "scores_best = cross_val_score(best_model_logreg, x_train_clf, y_train, cv=5, scoring='accuracy')\n",
    "\n",
    "# Decision tree\n",
    "param_grid_tree = {'max_depth': [2, 3, 5, 7, 10, 15, 20, 30, None], 'min_samples_split': [2, 5, 10, 20, 50], 'min_samples_leaf': [1, 2, 5, 10, 20], 'criterion': ['gini', 'entropy', 'log_loss'], 'class_weight': ['balanced'], 'max_features': [None, 'sqrt', 'log2']}\n",
    "random_search_tree = RandomizedSearchCV(estimator=DecisionTreeClassifier(random_state=42), param_distributions=param_grid_tree, n_iter=150, cv=5, scoring='accuracy', n_jobs=-1, random_state=42, verbose=0)\n",
    "random_search_tree.fit(x_train, y_train) \n",
    "best_model_tree = random_search_tree.best_estimator_\n",
    "y_pred_cl_tree = best_model_tree.predict(x_test)\n",
    "y_pred_pr_tree = best_model_tree.predict_proba(x_test)[:, 1]\n",
    "accuracy_best_tree = accuracy_score(y_test, y_pred_cl_tree)\n",
    "roc_auc_best_tree = roc_auc_score(y_test, y_pred_pr_tree)\n",
    "ap_tree = average_precision_score(y_test, y_pred_pr_tree)\n",
    "scores_tree = cross_val_score(best_model_tree, x_train, y_train, cv=5, scoring='accuracy')\n",
    "\n",
    "# Gradient boosting\n",
    "parameters_GB = {'n_estimators': randint(100, 500), 'learning_rate': uniform(0.01, 0.19), 'max_depth': randint(2, 6), 'subsample': uniform(0.7, 0.3)}\n",
    "random_search_GB = RandomizedSearchCV(estimator=GradientBoostingClassifier(random_state=42), param_distributions=parameters_GB, n_iter=150, cv=5, scoring='roc_auc', n_jobs=-1, random_state=42, verbose=0)\n",
    "random_search_GB.fit(x_train, y_train)\n",
    "best_clf_GB = random_search_GB.best_estimator_\n",
    "\n",
    "y_pred_cl_GB = best_clf_GB.predict(x_test)               \n",
    "accuracy_GB = accuracy_score(y_test, y_pred_cl_GB)\n",
    "y_pred_proba_GB = best_clf_GB.predict_proba(x_test)[:, 1]\n",
    "roc_auc_GB = roc_auc_score(y_test, y_pred_proba_GB)\n",
    "ap_GB = average_precision_score(y_test, y_pred_proba_GB)\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"FINAL COMPARISON OF ALL MODELS\")\n",
    "print(\"=\"*80)\n",
    "print(f\"\\n{'Model':<30} {'Accuracy':<12} {'ROC AUC':<12} {'Avg Precision':<15}\")\n",
    "print(\"-\" * 80)\n",
    "print(f\"{'Logistic Regression':<30} {accuracy_bestlr:<12.4f} {roc_auc_bestlr:<12.4f} {ap_GB:<15.4f}\") # using ap_GB as placeholder for alignment\n",
    "print(f\"{'Decision Tree':<30} {accuracy_best_tree:<12.4f} {roc_auc_best_tree:<12.4f} {ap_tree:<15.4f}\")\n",
    "print(f\"{'Gradient Boosting':<30} {accuracy_GB:<12.4f} {roc_auc_GB:<12.4f} {ap_GB:<15.4f}\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "\n",
    "# \n",
    "# FINAL SUBMISSION \n",
    "# \n",
    "from sklearn.base import clone\n",
    "\n",
    "# 1. Define the EXACT preprocessing that worked for best_clf_GB\n",
    "def preprocess_final(df):\n",
    "    df = df.copy()\n",
    "    df['Age'] = df['Age'].fillna(df['Age'].median())\n",
    "    if 'Fare' in df.columns:\n",
    "        df['Fare'] = df['Fare'].fillna(df['Fare'].median())\n",
    "    \n",
    "    df['FamilySize'] = df['SibSp'] + df['Parch'] + 1\n",
    "    df['IsAlone'] = np.where(df['FamilySize'] == 1, 1, 0)\n",
    "    \n",
    "    cols_to_drop = ['SibSp', 'Parch', 'Ticket', 'Fare', 'Cabin', 'Embarked', 'Name']\n",
    "    df.drop([col for col in cols_to_drop if col in df.columns], axis=1, inplace=True)\n",
    "    df = pd.get_dummies(df, columns=['Sex'], drop_first=True)\n",
    "    return df\n",
    "\n",
    "# 2. Load data with CORRECT Kaggle paths\n",
    "train_full = pd.read_csv('/kaggle/input/competitions/titanic/train.csv', index_col=0)\n",
    "test_kaggle = pd.read_csv('/kaggle/input/competitions/titanic/test.csv', index_col=0)\n",
    "\n",
    "# 3. Save PassengerId BEFORE any processing\n",
    "submission_ids = test_kaggle.index\n",
    "\n",
    "# 4. Apply preprocessing\n",
    "train_processed = preprocess_final(train_full)\n",
    "test_processed = preprocess_final(test_kaggle)\n",
    "\n",
    "# 5. Align columns and separate X/y\n",
    "train_processed, test_processed = train_processed.align(test_processed, join='left', axis=1, fill_value=0)\n",
    "\n",
    "X_final = train_processed.drop('Survived', axis=1, errors='ignore')\n",
    "test_processed = test_processed.drop('Survived', axis=1, errors='ignore') # CRITICAL FIX\n",
    "y_final = train_full['Survived']\n",
    "\n",
    "# 6. Use the ACTUAL best model found by RandomizedSearch\n",
    "print(\"\\nParameters from best_clf_GB:\")\n",
    "print(best_clf_GB.get_params())\n",
    "\n",
    "final_model = clone(best_clf_GB)\n",
    "final_model.random_state = 42\n",
    "\n",
    "print(\"\\nTraining final model on 100% of data...\")\n",
    "final_model.fit(X_final, y_final)\n",
    "\n",
    "# 7. Predict and Save\n",
    "predictions = final_model.predict(test_processed)\n",
    "\n",
    "submission = pd.DataFrame({\n",
    "    'PassengerId': submission_ids,\n",
    "    'Survived': predictions\n",
    "})\n",
    "\n",
    "submission.to_csv('/kaggle/working/submission.csv', index=False)\n",
    "\n",
    "print(\"\\n✅ Done!\")\n",
    "print(f\"Total rows: {len(submission)} (Expected: 418)\")\n",
    "print(submission.head())"
   ],
